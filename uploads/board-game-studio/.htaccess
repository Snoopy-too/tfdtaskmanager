# Disable directory listing to prevent asset enumeration
Options -Indexes

# Disable PHP engine if mod_php is loaded
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Prevent script execution in the uploaded asset directory
<FilesMatch "\.(php|php[0-9]|phtml|phar|pl|py|cgi|sh|inc)$">
    Require all denied
</FilesMatch>

# Prevent direct access to .htaccess
<Files ".htaccess">
    Require all denied
</Files>

# Allow cross-origin asset requests for HTML5 Canvas rendering & PDF exports
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>
