# Disable directory listing to prevent asset enumeration
Options -Indexes

# Prevent PHP script execution in the uploaded asset directory for security
<FilesMatch "\.php$">
    Require all denied
</FilesMatch>

# Prevent direct access to .htaccess
<Files ".htaccess">
    Require all denied
</Files>

# Allow cross-origin asset requests for HTML5 Canvas rendering & PDF exports
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>
